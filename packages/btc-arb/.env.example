# Credentials template for pi-btc-arb.
#
# Copy this to `.env` IN THIS DIRECTORY and fill it in. `.env` is gitignored; this file is not,
# so never put a real key here.
#
#     cp .env.example .env
#     $EDITOR .env
#     set -a; source .env; set +a
#
# The bot does NOT read this file itself - it reads the environment. Sourcing is a deliberate
# extra step: it means a stray file in the working directory can never silently arm live trading.

# --- Credentials -------------------------------------------------------------------------------
# Create the key at https://www.binance.com/en/my/settings/api-management
#   - Enable "Spot & Margin Trading". Leave withdrawals DISABLED.
#   - Restrict access to your bot host's egress IP.
# For the testnet, use a separate key from https://testnet.binance.vision
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Live gate ---------------------------------------------------------------------------------
# One of four conditions required to place real orders. The others are `mode: "live"` in the
# config file and the `--live` flag. Leave this commented out until you actually mean it -
# with it unset, a `--live` run downgrades to paper and logs why.
# ARB_LIVE_CONFIRM=I_UNDERSTAND_THE_RISK

# --- Optional overrides ------------------------------------------------------------------------
# ARB_MODE=paper          # paper | live
# ARB_TESTNET=1           # point both REST and WebSocket at the Spot testnet
# ARB_LOG_LEVEL=info      # debug | info | warn | error
