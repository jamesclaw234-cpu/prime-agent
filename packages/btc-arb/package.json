{
	"name": "@earendil-works/pi-btc-arb",
	"version": "0.7.1",
	"private": true,
	"description": "Binance Spot triangular arbitrage scanner and execution engine, paper-trading by default",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"pi-arb": "./dist/cli.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"test": "vitest --run",
		"start": "npx tsx src/cli.ts run"
	},
	"keywords": [
